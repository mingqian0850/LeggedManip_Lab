<?xml version="1.0"?>
<robot name="door_with_lever">
  <material name="frame_gray"><color rgba="0.16 0.18 0.20 1"/></material>
  <material name="door_blue"><color rgba="0.18 0.34 0.52 1"/></material>
  <material name="handle_metal"><color rgba="0.72 0.74 0.76 1"/></material>

  <link name="door_frame">
    <visual>
      <origin xyz="0 0 1.05"/>
      <geometry><box size="0.12 0.12 2.10"/></geometry>
      <material name="frame_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 1.05"/>
      <geometry><box size="0.12 0.12 2.10"/></geometry>
    </collision>
    <visual>
      <origin xyz="0 0.45 2.04"/>
      <geometry><box size="0.12 1.02 0.12"/></geometry>
      <material name="frame_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0.45 2.04"/>
      <geometry><box size="0.12 1.02 0.12"/></geometry>
    </collision>
  </link>

  <link name="door_panel">
    <inertial>
      <origin xyz="0 0.45 1.0"/>
      <mass value="18.0"/>
      <inertia ixx="6.075" ixy="0" ixz="0" iyy="6.004" iyz="0" izz="1.216"/>
    </inertial>
    <visual>
      <origin xyz="0 0.45 1.0"/>
      <geometry><box size="0.050 0.90 2.00"/></geometry>
      <material name="door_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0.45 1.0"/>
      <geometry><box size="0.050 0.90 2.00"/></geometry>
    </collision>
  </link>

  <joint name="door_hinge" type="revolute">
    <parent link="door_frame"/>
    <child link="door_panel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="1.65" effort="180" velocity="1.5"/>
    <dynamics damping="3.0" friction="2.0"/>
  </joint>

  <link name="lever_handle">
    <inertial>
      <origin xyz="-0.075 -0.09 0"/>
      <mass value="0.45"/>
      <inertia ixx="0.0018" ixy="0" ixz="0" iyy="0.0010" iyz="0" izz="0.0010"/>
    </inertial>
    <visual>
      <origin xyz="-0.055 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.040" length="0.11"/></geometry>
      <material name="handle_metal"/>
    </visual>
    <collision>
      <origin xyz="-0.055 0 0" rpy="0 1.57079632679 0"/>
      <geometry><cylinder radius="0.040" length="0.11"/></geometry>
    </collision>
    <visual>
      <origin xyz="-0.105 -0.10 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.025" length="0.20"/></geometry>
      <material name="handle_metal"/>
    </visual>
    <collision>
      <origin xyz="-0.105 -0.10 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.025" length="0.20"/></geometry>
    </collision>
  </link>

  <joint name="handle_joint" type="revolute">
    <parent link="door_panel"/>
    <child link="lever_handle"/>
    <origin xyz="-0.055 0.72 1.05" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.75" effort="25" velocity="2.5"/>
    <dynamics damping="0.25" friction="0.35"/>
  </joint>

  <link name="handle_grasp">
    <visual>
      <geometry><sphere radius="0.018"/></geometry>
      <material name="handle_metal"/>
    </visual>
  </link>

  <joint name="handle_grasp_fixed" type="fixed">
    <parent link="lever_handle"/>
    <child link="handle_grasp"/>
    <origin xyz="-0.105 -0.19 0" rpy="0 0 0"/>
  </joint>
</robot>
